NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-or-secret-key
GROQ_API_KEY=your-groq-api-key
# Optional: Vision model for scanned PDF OCR. Defaults to qwen/qwen3.8-27b (the
# only vision model currently served by Groq). max_tokens defaults to 1024 to
# stay inside Groq's free-tier OTPM admission limit; raise GROQ_VISION_MAX_TOKENS
# on a paid tier if dense pages come back truncated.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MAX_TOKENS=1024
# Optional: main chat + title model. Defaults to qwen/qwen3.8-27b (verified
# available; meta-llama/llama-4-scout was removed from Groq).
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: fallback vision model for scanned PDF OCR when Groq fails.
# Defaults to inclusionai/ling-3.0-flash-vl:free (costs nothing, works even
# with an empty OpenRouter credit balance, subject to OpenRouter's free-tier
# request limits).
OPENROUTER_VISION_MODEL=inclusionai/ling-3.0-flash-vl:free
OPENROUTER_EMBEDDING_MODEL=perplexity/pplx-embed-v1-0.6b

# Optional. Without these, rate limits are per-instance and reset on cold starts.
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Optional. Proxies in front of this app; the client address is read this many
# hops from the right of x-forwarded-for. Defaults to 1 (Vercel, or Cloudflare
# in front of Vercel).
RATE_LIMIT_TRUSTED_PROXY_HOPS=1
